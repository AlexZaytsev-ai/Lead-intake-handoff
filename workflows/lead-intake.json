      "id": "f76fc425-3ebc-4884-a376-ed4f24f462d6",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"client_name\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"repair_type\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"area_sqm\": {\n      \"type\": [\"number\", \"null\"]\n    },\n    \"city\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"desired_timing\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"knowledge_query\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"budget\": {\n      \"type\": [\"number\", \"null\"]\n    },\n    \"handoff_requested\": {\n      \"type\": \"boolean\"\n    },\n    \"unknown_fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"repair_type\",\n          \"area_sqm\",\n          \"city\",\n          \"desired_timing\",\n          \"budget\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"client_name\",\n    \"repair_type\",\n    \"area_sqm\",\n    \"city\",\n    \"desired_timing\",\n    \"knowledge_query\",\n    \"budget\",\n    \"handoff_requested\",\n    \"unknown_fields\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        864,
        144
      ],
      "id": "fa0e8a70-9057-4a7f-b5ee-b41c28ea1a53",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads\nSET\n    repair_type = COALESCE($2::text, repair_type),\n    area_sqm = COALESCE($3::numeric, area_sqm),\n    city = COALESCE($4::text, city),\n    desired_timing = COALESCE($5::text, desired_timing),\n    budget = COALESCE($6::numeric, budget),\n    handoff_requested = handoff_requested OR $7::boolean,\n    client_name = COALESCE($8::text, client_name),\n    updated_at = NOW()\nWHERE id = $1::bigint\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [\n  $('Сохранить заявку и сообщение').item.json.id,\n  $json.output.repair_type,\n  $json.output.area_sqm,\n  $json.output.city,\n  $json.output.desired_timing,\n  $json.output.budget,\n  $json.output.handoff_requested,\n  $json.output.client_name\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1024,
        -80
      ],
      "id": "f9cbbc2f-8254-4ad3-807b-55110781d4b8",
      "name": "Обновить данные заявки"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads\nSET unknown_fields = ARRAY(\n    SELECT DISTINCT field\n    FROM unnest(\n        unknown_fields ||\n        ARRAY(SELECT jsonb_array_elements_text($2::jsonb))\n    ) AS field\n    WHERE CASE field\n        WHEN 'repair_type' THEN repair_type IS NULL\n        WHEN 'area_sqm' THEN area_sqm IS NULL\n        WHEN 'city' THEN city IS NULL\n        WHEN 'desired_timing' THEN desired_timing IS NULL\n        WHEN 'budget' THEN budget IS NULL\n        WHEN 'client_name' THEN client_name IS NULL\n        ELSE false\n    END\n),\nupdated_at = NOW()\nWHERE id = $1::bigint\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ (() => {\n  const lead = $('Заявка ещё обрабатывается?').item.json;\n  const text = (lead.incoming_text ?? '').trim();\n\n  const explicitUnknown = /^(?:я\\s+)?(?:пока\\s+)?(?:не знаю|не уверен|не уверена|затрудняюсь ответить)[.!?]*$/i.test(text);\n\n  const nameRefused =\n    lead.last_question_field === 'client_name' &&\n    /^(?:я\\s+)?(?:не хочу (?:называть|указывать|сообщать)(?: (?:своё|свое))? имя|не буду (?:называть|указывать|сообщать)(?: (?:своё|свое))? имя|без имени)[.!?]*$/i.test(text);\n\n  const unknown =\n    (explicitUnknown || nameRefused) && lead.last_question_field\n      ? [lead.last_question_field]\n      : [];\n\n  return [$json.id, JSON.stringify(unknown)];\n})() }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1216,
        -80
      ],
      "id": "7a3a0582-cf0f-4bd0-87f9-87c99eb80775",
      "name": "Обновить неизвестные поля"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Обновить неизвестные поля').item.json;\n\nconst questions = [\n  {\n    field: 'repair_type',\n    text: 'Какой ремонт планируете: косметический, капитальный или другой?'\n  },\n  {\n    field: 'area_sqm',\n    text: 'Какая площадь квартиры в квадратных метрах?'\n  },\n  {\n    field: 'city',\n    text: 'В каком городе находится квартира?'\n  },\n  {\n    field: 'desired_timing',\n    text: 'Когда вы планируете начать ремонт?'\n  },\n  {\n    field: 'budget',\n    text: 'На какой бюджет вы ориентируетесь? Если пока не знаете, так и напишите.'\n  },\n  {\n    field: 'client_name',\n    text: 'Как к вам обращаться?'\n  }\n];\n\nconst unknownFields = lead.unknown_fields ?? [];\n\n// Просьба о сотруднике имеет приоритет.\nif (lead.handoff_requested) {\n  return {\n    json: {\n      ...lead,\n      action: 'handoff',\n      handoff_reason: 'client_requested'\n    }\n  };\n}\n\n// Ищем первый вопрос, на который ещё нет ответа.\nconst nextQuestion = questions.find((question) => {\n  const value = lead[question.field];\n  const isEmpty = value === null || value === undefined || value === '';\n  const isUnknown = unknownFields.includes(question.field);\n\n  return isEmpty && !isUnknown;\n});\n\nif (nextQuestion) {\n  return {\n    json: {\n      ...lead,\n      action: 'ask',\n      question_field: nextQuestion.field,\n      question_text: nextQuestion.text\n    }\n  };\n}\n\n// Все обязательные поля заполнены или отмечены как неизвестные.\nreturn {\n  json: {\n    ...lead,\n    action: 'handoff',\n    handoff_reason: 'data_collected'\n  }\n};"
      },
