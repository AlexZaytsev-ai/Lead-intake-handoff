      "id": "0b5c5d2e-464a-4f80-b290-b4bf4181a3e8",
      "name": "Сохранить заявку и сообщение"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "66f90e70-753c-4dd6-86fa-9c7e0d2d9f24",
              "leftValue": "={{ $json.is_new_message }}",
              "rightValue": "",
              "operator": {
