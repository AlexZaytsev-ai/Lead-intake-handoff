      ],
      "id": "df4abdb0-059d-4938-b415-058ba817d84b",
      "name": "Telegram Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH lead AS (\n    INSERT INTO leads (chat_id, username, first_name)\n    VALUES ($1, $2, $3)\n    ON CONFLICT (chat_id) DO UPDATE\n    SET username = EXCLUDED.username,\n        first_name = EXCLUDED.first_name,\n        updated_at = NOW()\n    RETURNING *\n),\nsaved_message AS (\n    INSERT INTO messages (\n        lead_id,\n        telegram_message_id,\n        direction,\n        text,\n        processing_status\n    )\n    SELECT id, $4, 'incoming', $5, 'pending'\n    FROM lead\n    ON CONFLICT (lead_id, direction, telegram_message_id)\n    DO NOTHING\n    RETURNING id\n)\nSELECT\n    lead.*,\n    $5::text AS incoming_text,\n    EXISTS (SELECT 1 FROM saved_message) AS is_new_message,\n    (SELECT id FROM saved_message) AS saved_message_id\nFROM lead;",
        "options": {
          "queryReplacement": "={{ [\n  $json.message.chat.id,\n  $json.message.from.username ?? null,\n  $json.message.from.first_name ?? null,\n  $json.message.message_id,\n  $json.message.text\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -208,
