      "id": "c412f96e-0d2b-48cb-84e0-2523e116aa53",
      "name": "Запомнить вопрос"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\n\nfunction show(value) {\n  return value === null || value === undefined || value === ''\n    ? 'Не указано'\n    : value;\n}\n\nconst contact = lead.username\n  ? `@${lead.username}`\n  : `Telegram ID: ${lead.chat_id}`;\n\nconst reason = lead.handoff_reason === 'client_requested'\n  ? 'Клиент попросил сотрудника'\n  : 'Данные собраны';\n\nconst summary = [\n  `📋 Заявка №${lead.id}`,\n  `Клиент: ${show(lead.client_name || lead.first_name)}`,\n  `Контакт: ${contact}`,\n  '',\n  `Ремонт: ${show(lead.repair_type)}`,\n  `Площадь: ${lead.area_sqm ? lead.area_sqm + ' м²' : 'Не указана'}`,\n  `Город: ${show(lead.city)}`,\n  `Сроки: ${show(lead.desired_timing)}`,\n  `Бюджет: ${lead.budget !== null ? lead.budget + ' ₽' : 'Не указан'}`,\n  '',\n  `Причина передачи: ${reason}`\n].join('\\n');\n\nreturn {\n  json: {\n    ...lead,\n    summary\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3184,
        64
      ],
      "id": "7a53f4c0-8450-478d-8a35-604a35c087ca",
      "name": "Подготовить сводку"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO handoffs (\n    lead_id,\n    manager_chat_id,\n    reason,\n    summary,\n    source_message_id\n)\nVALUES (\n    $1::bigint,\n    $2::bigint,\n    $3::text,\n    $4::text,\n    $5::bigint\n)\nON CONFLICT (lead_id, manager_chat_id)\nDO NOTHING\nRETURNING *;",
        "options": {
