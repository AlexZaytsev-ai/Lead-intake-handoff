        "query": "SELECT COALESCE(\n    jsonb_agg(to_jsonb(found)),\n    '[]'::jsonb\n) AS knowledge\nFROM (\n    SELECT id, topic, content\n    FROM repair_knowledge\n    WHERE to_tsvector('russian', topic || ' ' || content)\n          @@ plainto_tsquery('russian', $1::text)\n    ORDER BY\n        ts_rank(\n            to_tsvector('russian', topic || ' ' || content),\n            plainto_tsquery('russian', $1::text)\n        ) DESC,\n        id\n    LIMIT 3\n) AS found;",
